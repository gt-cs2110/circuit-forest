{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "sortPackageJson": false,
    "ignorePatterns": [
        "target",
        ".yarn",
        "/*.js",
        "/*.mjs",
        "/*.cjs",
        "/index.js",
        "index.d.ts",
        "pnpm-lock.yaml"
    ]
}
